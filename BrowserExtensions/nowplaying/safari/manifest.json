{
  "manifest_version": 2,
  "name": "Beardie Now Playing",
  "short_name": "Beardie",
  "description": "Companion extension for Beardie Now Playing sources.",
  "version": "1.0.1",
  "icons": {
    "16": "icons/Icon-16.png",
    "32": "icons/Icon-32.png",
    "48": "icons/Icon-48.png",
    "64": "icons/Icon-64.png",
    "128": "icons/Icon-128.png"
  },
  "background": {
    "scripts": ["shared/utils.js", "shared/background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_idle",
      "all_frames": true,
      "js": ["shared/utils.js", "shared/content.js"]
    }
  ],
  "permissions": ["tabs", "nativeMessaging", "storage", "scripting", "<all_urls>"]
}
